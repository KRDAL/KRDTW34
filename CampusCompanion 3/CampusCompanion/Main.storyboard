            </objects>
            <point key="canvasLocation" x="827" y="85"/>
        </scene>
        <!--Campus Events-->
        <scene sceneID="detailScene">
            <objects>
                <viewController id="detailVC" customClass="DetailViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="detailView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Campus Events" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="messageLabel">
                                <rect key="frame" x="137.33333333333334" y="468" width="118.33333333333334" height="20.333333333333314"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="detailSafe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="messageLabel" firstAttribute="centerX" secondItem="detailSafe" secondAttribute="centerX" id="d1"/>
                            <constraint firstItem="messageLabel" firstAttribute="centerY" secondItem="detailSafe" secondAttribute="centerY" id="d2"/>
                            <constraint firstItem="messageLabel" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="detailSafe" secondAttribute="leading" constant="24" id="d3"/>
                            <constraint firstItem="detailSafe" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="messageLabel" secondAttribute="trailing" constant="24" id="d4"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Campus Events" id="detailNav"/>
                    <connections>
                        <outlet property="messageLabel" destination="messageLabel" id="do1"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="detailFR" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1576" y="85"/>
        </scene>
    </scenes>
    <inferredMetricsTieBreakers>
        <segue reference="announcementDetailSegue"/>
    </inferredMetricsTieBreakers>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
