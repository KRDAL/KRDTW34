                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="welcomeFR" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="138" y="85"/>
        </scene>
        <!--Campus Announcements-->
        <scene sceneID="announcementsScene">
            <objects>
                <tableViewController id="announcementsVC" customClass="AnnouncementsViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                    <tableView key="view" clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="prototypes" style="plain" separatorStyle="default" rowHeight="84" sectionHeaderHeight="28" sectionFooterHeight="28" id="announcementsTable">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <prototypes>
                            <tableViewCell clipsSubviews="YES" contentMode="scaleToFill" selectionStyle="default" indentationWidth="10" reuseIdentifier="AnnouncementCell" rowHeight="84" id="announcementCell" customClass="AnnouncementCell" customModule="CampusCompanion" customModuleProvider="target">
                                <rect key="frame" x="0.0" y="50" width="393" height="84"/>
                                <autoresizingMask key="autoresizingMask"/>
                                <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" tableViewCell="announcementCell" id="cellContent">
                                    <rect key="frame" x="0.0" y="0.0" width="393" height="84"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <subviews>
                                        <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="categoryIcon">
                                            <rect key="frame" x="16" y="26" width="32" height="32"/>
                                        </imageView>
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Announcement Title" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="announcementTitle">
                                            <rect key="frame" x="59.999999999999986" y="15.999999999999998" width="156.66666666666663" height="19.333333333333329"/>
                                            <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                                        </label>
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Category • Date" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="announcementDate">
                                            <rect key="frame" x="60" y="41.333333333333336" width="349" height="15.666666666666664"/>
                                            <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                        </label>
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Normal" textAlignment="right" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="announcementPriority">
                                            <rect key="frame" x="365" y="18.666666666666668" width="44" height="14.333333333333332"/>
                                            <fontDescription key="fontDescription" type="boldSystem" pointSize="12"/>
                                        </label>
                                    </subviews>
                                    <constraints>
                                        <constraint firstItem="categoryIcon" firstAttribute="leading" secondItem="cellContent" secondAttribute="leading" constant="16" id="ac1"/>
                                        <constraint firstItem="announcementDate" firstAttribute="leading" secondItem="announcementTitle" secondAttribute="leading" id="ac10"/>
                                        <constraint firstItem="announcementDate" firstAttribute="top" secondItem="announcementTitle" secondAttribute="bottom" constant="6" id="ac11"/>
                                        <constraint firstItem="announcementDate" firstAttribute="trailing" secondItem="cellContent" secondAttribute="trailing" constant="16" id="ac12"/>
                                        <constraint firstItem="categoryIcon" firstAttribute="centerY" secondItem="cellContent" secondAttribute="centerY" id="ac2"/>
                                        <constraint firstItem="categoryIcon" firstAttribute="width" constant="32" id="ac3"/>
                                        <constraint firstItem="categoryIcon" firstAttribute="height" constant="32" id="ac4"/>
                                        <constraint firstItem="announcementTitle" firstAttribute="leading" secondItem="categoryIcon" secondAttribute="trailing" constant="12" id="ac5"/>
                                        <constraint firstItem="announcementTitle" firstAttribute="top" secondItem="cellContent" secondAttribute="top" constant="16" id="ac6"/>
                                        <constraint firstItem="announcementPriority" firstAttribute="trailing" secondItem="cellContent" secondAttribute="trailing" constant="16" id="ac7"/>
                                        <constraint firstItem="announcementPriority" firstAttribute="centerY" secondItem="announcementTitle" secondAttribute="centerY" id="ac8"/>
                                        <constraint firstItem="announcementTitle" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="announcementPriority" secondAttribute="leading" constant="-8" id="ac9"/>
                                    </constraints>
                                </tableViewCellContentView>
                                <connections>
                                    <outlet property="categoryIconImageView" destination="categoryIcon" id="aco1"/>
                                    <outlet property="dateLabel" destination="announcementDate" id="aco3"/>
                                    <outlet property="priorityLabel" destination="announcementPriority" id="aco4"/>
                                    <outlet property="titleLabel" destination="announcementTitle" id="aco2"/>
                                </connections>
                            </tableViewCell>
                        </prototypes>
                        <connections>
                            <outlet property="dataSource" destination="announcementsVC" id="at1"/>
                            <outlet property="delegate" destination="announcementsVC" id="at2"/>
                        </connections>
                    </tableView>
                    <navigationItem key="navigationItem" title="Campus Announcements" id="announcementsNav"/>
                    <connections>
                        <segue destination="detailVC" kind="show" identifier="ShowAnnouncementDetailSegue" id="announcementDetailSegue"/>
                    </connections>
